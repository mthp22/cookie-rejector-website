
---
const features = [
  {
    title: 'Automatic detection',
    description: 'Looks for common cookie consent banners on the sites you visit.',
    axis: 'rotateX',
    direction: 180,
  },
  {
    title: 'Rejects optional cookies',
    description: 'Selects the reject or decline options a banner offers, instead of accepting them.',
    axis: 'rotateY',
    direction: -180,
  },
  {
    title: 'Lightweight',
    description: 'Runs in the browser. No account, no background service, no separate app.',
    axis: 'rotateX',
    direction: -180,
  },
  {
    title: 'Configurable',
    description: 'Change how it behaves from the extension’s options page.',
    axis: 'rotateY',
    direction: 180,
  },
];
---

<section id="features" class="features">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">What it does</h2>
    </div>

    <div class="features-grid">
      {features.map((feature, index) => (
        <article
          class="feature-card"
          data-axis={feature.axis}
          data-direction={feature.direction}
          tabindex="0"
        >
          <div class="card-inner">
            <div class="card-face card-front">
              <span class="card-index">0{index + 1}</span>
              <h3>{feature.title}</h3>
              <span class="card-arrow">↗</span>
            </div>

            <div class="card-face card-back">
              <span class="card-index">0{index + 1}</span>
              <p>{feature.description}</p>
              <span class="card-arrow">↙</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    padding: 7rem 0;
    background: var(--color-primary);
    overflow: hidden;
  }

  .container {
    width: min(100% - 3rem, 1200px);
    margin-inline: auto;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: clamp(3.5rem, 9vw, 7rem);
    text-align: center;
    letter-spacing: -0.085em;
    line-height: 0.9;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    perspective: 1400px;
  }

  .feature-card {
    min-width: 0;
    height: 370px;
    perspective: 1400px;
    cursor: pointer;
    outline: none;
  }

  .card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .card-face {
    position: absolute;
    inset: 0;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    background: var(--color-secondary);
    color: var(--color-text);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .card-back {
    transform: rotateX(180deg);
  }

  .feature-card[data-axis="rotateY"] .card-back {
    transform: rotateY(180deg);
  }

  .card-index {
    font-size: 0.75rem;
    font-weight: 700;
    opacity: 0.45;
  }

  .card-face h3 {
    max-width: 95%;
    font-size: clamp(1.8rem, 2.7vw, 2.8rem);
    letter-spacing: -0.075em;
    line-height: 0.98;
  }

  .card-face p {
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    line-height: 1.45;
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .card-arrow {
    position: absolute;
    right: 1.5rem;
    bottom: 1.25rem;
    font-size: 1.6rem;
    font-weight: 700;
    opacity: 0.55;
  }

  .feature-card:focus-visible .card-face {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media (max-width: 900px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .features {
      padding: 5rem 0;
    }

    .features-grid {
      gap: 0.75rem;
    }

    .feature-card {
      height: 270px;
    }

    .card-face {
      padding: 1rem;
    }

    .card-face h3 {
      font-size: clamp(1.65rem, 7vw, 2.3rem);
    }

    .card-face p {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-inner {
      will-change: auto;
    }
  }
</style>

<script>

import gsap from 'gsap';

const cards = document.querySelectorAll('.feature-card');

const reducedMotion = window.matchMedia(
  '(prefers-reduced-motion: reduce)'
).matches;

cards.forEach((card) => {
  const inner = card.querySelector('.card-inner');
  const axis = card.dataset.axis;
  const direction = Number(card.dataset.direction);

  const flip = (active) => {
    gsap.to(inner, {
      [axis]: active ? direction : 0,
      duration: 0.8,
      ease: 'power3.inOut',
      overwrite: true,
    });
  };

  card.addEventListener('mouseenter', () => flip(true));
  card.addEventListener('mouseleave', () => flip(false));
  card.addEventListener('focus', () => flip(true));
  card.addEventListener('blur', () => flip(false));
});

// Automatic flip sequence on every page load
if (!reducedMotion) {
  const timeline = gsap.timeline({ delay: 0.3 });

  cards.forEach((card, index) => {
    const inner = card.querySelector('.card-inner');
    const axis = card.dataset.axis;
    const direction = Number(card.dataset.direction);

    timeline
      .to(inner, {
        [axis]: direction,
        duration: 0.75,
        ease: 'power3.inOut',
      }, index * 0.35)
      .to(inner, {
        [axis]: 0,
        duration: 0.75,
        ease: 'power3.inOut',
      }, index * 0.35 + 0.85);
  });
}

</script>