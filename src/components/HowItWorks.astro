---
const steps = [
  {
    number: '1',
    title: 'Install',
    description: 'Add Cookie Rejector to Microsoft Edge from the Add-ons store.',
  },
  {
    number: '2',
    title: 'Browse',
    description: 'Visit websites as you normally would.',
  },
  {
    number: '3',
    title: 'Reject',
    description: 'When a supported cookie banner appears, the extension attempts to reject its optional cookies.',
  },
];
---

<section id="how-it-works" class="how-it-works">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title" data-animate="heading">How It Works</h2>
    </div>

    <div class="content-layout">
      <div class="steps">
        {steps.map((step) => (
          <div class="step">
            <div class="step-number">{step.number}</div>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-description">{step.description}</p>
          </div>
        ))}
      </div>

      <div class="easy-display" aria-label="Easy as one, two, three">
        <div class="number-sequence">
          <span class="number number-one">1</span>
          <span class="separator">→</span>
          <span class="number number-two">2</span>
          <span class="separator">→</span>
          <span class="number number-three">3</span>
        </div>
        <p>Easy as 1, 2, 3.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .how-it-works {
    padding: 5rem 0;
    /* background: var(--color-secondary); */
    width: min(100% - 2.5rem, 1050px);
    margin: 0 auto;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .how-it-works { padding: 7rem 0; }
  }

  .section-header {
    max-width: 36rem;
    margin: 0 auto 3rem;
    text-align: center;
    perspective: 1000px;
  }

  .section-title {
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    transform-origin: center bottom;
    will-change: transform, opacity, filter;
  }

  @media (min-width: 640px) {
    .section-title { font-size: 2.25rem; }
  }

  .content-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    max-width: 72rem;
    margin: 0 auto;
  }

  @media (min-width: 900px) {
    .content-layout {
      grid-template-columns: 1fr 220px;
      gap: 3rem;
    }
  }

  .steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    max-width: 56rem;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .step {
    text-align: center;
  }

  .step-number {
    width: 2.25rem;
    height: 2.25rem;
    margin: 0 auto 1rem;
    border-radius: 50%;
    background: var(--color-text-primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .step-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .step-description {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    max-width: 18rem;
    margin: 0 auto;
  }

  .easy-display {
    text-align: center;
    padding: 1rem;
  }

  .number-sequence {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
  }

  .number {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-text-secondary);
    opacity: 0.4;
    transition: opacity 0.3s ease, transform 0.3s ease;
    animation: highlight 3s infinite;
  }

  .number-one { animation-delay: 0s; }
  .number-two { animation-delay: 1s; }
  .number-three { animation-delay: 2s; }

  .separator {
    font-size: 1rem;
    color: var(--color-text-secondary);
    opacity: 0.5;
  }

  .easy-display p {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  @keyframes highlight {
    0%, 25%, 100% {
      opacity: 0.4;
      transform: translateY(0);
    }
    8%, 20% {
      opacity: 1;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .number {
      animation: none;
      opacity: 1;
    }
  }

  @media (max-width: 899px) {
    .easy-display {
      padding-top: 0;
    }
  }
  .reveal-header {
  opacity: 0;
  transform: translateY(24px);
  filter: blur(6px);
  animation: headerReveal 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

@keyframes headerReveal {
  to {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .reveal-header {
    opacity: 1;
    transform: none;
    filter: none;
    animation: none;
  }
}
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const headings = document.querySelectorAll('[data-animate="heading"]');

  headings.forEach((heading) => {
    gsap.fromTo(
      heading,
      {
        opacity: 0,
        y: 70,
        scale: 0.85,
        rotateX: -25,
        filter: "blur(12px)",
      },
      {
        opacity: 1,
        y: 0,
        scale: 1,
        rotateX: 0,
        filter: "blur(0px)",
        duration: 1.3,
        ease: "elastic.out(1, 0.65)",
        scrollTrigger: {
          trigger: heading,
          start: "top 85%",
          once: true,
        },
      }
    );
  });

  const steps = document.querySelectorAll(".steps .step");

  gsap.fromTo(
    steps,
    {
      opacity: 0,
      y: 60,
      scale: 0.92,
      filter: "blur(8px)",
    },
    {
      opacity: 1,
      y: 0,
      scale: 1,
      filter: "blur(0px)",
      duration: 1,
      stagger: 0.2,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".steps",
        start: "top 85%",
        once: true,
      },
    }
  );
</script>