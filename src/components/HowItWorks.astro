---
const steps = [
  {
    number: '01',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>`,
    title: 'Install',
    description: 'Add Cookie Rejector to your browser.',
  },
  {
    number: '02',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
    title: 'Browse',
    description: 'Visit websites as you normally would.',
  },
  {
    number: '03',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><line x1="9" y1="9" x2="15" y2="15"/><line x1="15" y1="9" x2="9" y2="15"/></svg>`,
    title: 'Reject',
    description: 'When a supported cookie banner is detected, Cookie Rejector attempts to reject optional cookies.',
  },
];
---

<section id="how-it-works" class="how-it-works">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Privacy-conscious browsing in three steps.</h2>
    </div>

    <div class="steps">
      <div class="steps-line"></div>
      {steps.map((step) => (
        <div class="step">
          <div class="step-indicator">
            <div class="step-circle" set:html={step.icon}></div>
            <div class="step-number">{step.number}</div>
          </div>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-description">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .how-it-works {
    padding: 5rem 0;
    background: var(--color-secondary);
  }

  @media (min-width: 768px) {
    .how-it-works { padding: 7rem 0; }
  }

  .section-header {
    text-align: center;
    max-width: 36rem;
    margin: 0 auto 4rem;
  }

  .section-title {
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  @media (min-width: 640px) {
    .section-title { font-size: 2.25rem; }
  }

  .steps {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .steps-line {
    display: none;
  }

  @media (min-width: 1024px) {
    .steps-line {
      display: block;
      position: absolute;
      top: 1.75rem;
      left: 20%;
      right: 20%;
      height: 1px;
      background: var(--color-border);
    }
  }

  .step {
    position: relative;
    text-align: center;
  }

  .step-indicator {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .step-circle {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: white;
    border: 2px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    transition: all 0.3s;
  }

  .step:hover .step-circle {
    border-color: var(--color-accent);
    box-shadow: 0 8px 20px rgba(163, 230, 53, 0.1);
    color: var(--color-accent-dark);
  }

  .step-number {
    position: absolute;
    top: -0.5rem;
    right: -0.5rem;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent-dark);
  }

  .step-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .step-description {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 18rem;
    margin: 0 auto;
  }
</style>
