---
import {HOME_URL } from '../config';

const currentYear = new Date().getFullYear();

const navLinks = [
  { label: 'Features', href: '#features' },
  { label: 'How it works', href: '#how-it-works' },
  { label: 'Privacy', href: '#privacy' },
  { label: 'FAQ', href: '#faq' },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-brand">
        <a href={HOME_URL} class="footer-logo" aria-label="Cookie Rejector Home">
          <span class="footer-name">Cookie Rejector</span>
        </a>
        <p class="footer-description">
          A Microsoft Edge extension that detects cookie consent banners and attempts to
          reject optional cookies.
        </p>
        <div class="footer-social">
          <a href="#" class="social-link" aria-label="GitHub repository" title="GitHub repository (placeholder)">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="footer-links">
        <h4 class="footer-heading">Navigation</h4>
        <ul class="footer-nav">
          {navLinks.map((link) => (
            <li><a href={link.href} class="footer-link">{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">{currentYear} Cookie Rejector. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
 
.footer {
  background: var(--color-secondary);
  border-top: 1px solid var(--color-border);
}

.footer .container {
  width: min(100% - 2.5rem, 1050px);
  margin-inline: auto;
}

.footer a {
  text-decoration: none;
}

.footer a:hover {
  text-decoration: none;
}

.footer-main {
  padding: 2.5rem 0;
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 3rem;
}

.footer-brand {
  max-width: 24rem;
}

.footer-logo {
  display: inline-block;
  margin-bottom: 0.6rem;
}

.footer-name {
  font-weight: 650;
  font-size: 1.05rem;
  letter-spacing: -0.025em;
}

.footer-description {
  font-size: 0.8125rem;
  color: var(--color-text-secondary);
  line-height: 1.65;
  max-width: 23rem;
  margin-bottom: 0.5rem;
}

.footer-links {
  display: grid;
  grid-template-columns: 1fr auto;
  align-content: start;
  column-gap: 2rem;
}

.footer-heading {
  grid-column: 1 / -1;
  font-size: 0.9125rem;
  font-weight: 650;
  margin-bottom: 0.85rem;
}

.footer-nav {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.footer-link {
  font-size: 0.8125rem;
  color: var(--color-text-secondary);
  transition: color 0.2s;
}

.footer-link:hover {
  color: var(--color-text-primary);
}

.footer-social {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
}

.social-link {
  width: 3rem;
  height: 3rem;
  border-radius: 0.95rem;
  background: white;
  border: 1px solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary);
  transition: all 0.2s;
}

.social-link svg {
  width: 17px;
  height: 17px;
}

.social-link:hover {
  border-color: var(--color-text-secondary);
}

.footer-bottom {
  padding: 1rem 0;
  border-top: 1px solid var(--color-border);
  display: flex;
  justify-content: center;
}

.footer-copyright {
  font-size: 0.7rem;
  color: var(--color-text-secondary);
}

@media (max-width: 640px) {
  .footer .container {
    width: calc(100% - 2rem);
  }

  .footer-main {
    grid-template-columns: 1fr;
    gap: 1.75rem;
    padding: 2rem 0;
  }

  .footer-links {
    grid-template-columns: 1fr auto;
  }
}
</style>