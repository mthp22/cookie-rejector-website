---
import { STORE_URL } from '../config';
---

<section class="cta">
  <div class="container">
    <div class="cta-card">
      <h2 class="cta-title">Get Cookie Rejector</h2>
      <p class="cta-description">
        Install the free extension from the Microsoft Edge Add-ons store.
      </p>
      <a href={STORE_URL} class="cta-button" rel="noopener">Add to Edge</a>
      <p class="cta-note">No account required.</p>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: 5rem 0;
    background: var(--color-primary);
  }

  @media (min-width: 768px) {
    .cta { padding: 7rem 0; }
  }

  .cta-card {
    background: var(--color-text-primary);
    border-radius: 1.5rem;
    padding: 2.5rem 1.5rem;
    text-align: center;
    max-width: 48rem;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .cta-card { padding: 3.5rem; }
  }

  .cta-title {
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: white;
    margin-bottom: 0.75rem;
  }

  @media (min-width: 640px) {
    .cta-title { font-size: 2.25rem; }
  }

  .cta-description {
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 2rem;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 2rem;
    font-size: 1rem;
    font-weight: 600;
    background: var(--color-accent);
    color: var(--color-accent-dark);
    border-radius: 9999px;
    transition: background 0.2s ease;
  }

  .cta-button:hover {
    background: #b5f060;
  }

  .cta-note {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.45);
  }
</style>
