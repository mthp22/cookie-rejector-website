---
const checklist = [
  'Clear enabled/disabled status indicator',
  'Real-time cookie banner detection status',
  'Privacy-focused behaviour description',
  'Quick access to customisable settings',
];
---

<section class="showcase">
  <div class="container showcase-inner">
    <div class="showcase-mockup">
      <div class="extension-popup">
        <div class="popup-header">
          <div class="popup-brand">
            <div class="popup-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </div>
            <div>
              <h4 class="popup-name">Cookie Rejector</h4>
              <p class="popup-version">v1.0.0</p>
            </div>
          </div>
        </div>

        <div class="popup-body">
          <div class="popup-row">
            <div class="popup-row-left">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-accent"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <span class="popup-label">Extension Status</span>
            </div>
            <div class="popup-status-active">
              <div class="status-indicator"></div>
              <span>Enabled</span>
            </div>
          </div>

          <div class="popup-row">
            <div class="popup-row-left">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-secondary"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              <span class="popup-label">Banner Detection</span>
            </div>
            <span class="popup-value">Active</span>
          </div>

          <div class="popup-behaviour">
            <div class="popup-row-left">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-accent"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
              <span class="popup-label">Privacy Behaviour</span>
            </div>
            <p class="popup-behaviour-text">Prefers rejecting optional cookies over accepting them.</p>
          </div>

          <button class="popup-settings">
            <div class="popup-row-left">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
              <span class="popup-label">Settings</span>
            </div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-secondary"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="showcase-content">
      <div class="showcase-badge">
        <span>Extension Interface</span>
      </div>
      <h2 class="showcase-title">Simple, transparent control.</h2>
      <p class="showcase-description">
        Cookie Rejector's popup gives you a clear overview of its status and behaviour. See at a glance whether the extension is active and how it's configured.
      </p>
      <ul class="showcase-checklist">
        {checklist.map((item) => (
          <li class="checklist-item">
            <div class="check-icon">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg>
            </div>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .showcase {
    padding: 5rem 0;
    background: var(--color-primary);
  }

  @media (min-width: 768px) {
    .showcase { padding: 7rem 0; }
  }

  .showcase-inner {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .showcase-inner {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .showcase-mockup {
    order: 2;
    max-width: 24rem;
    margin: 0 auto;
  }

  @media (min-width: 1024px) {
    .showcase-mockup { order: 1; margin: 0; }
  }

  .extension-popup {
    background: white;
    border-radius: 1rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.08);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }

  .popup-header {
    padding: 1rem 1.25rem;
    background: var(--color-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  .popup-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .popup-icon {
    width: 2rem;
    height: 2rem;
    background: var(--color-accent);
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .popup-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .popup-version {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .popup-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .popup-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem;
    background: var(--color-secondary);
    border-radius: 0.75rem;
  }

  .popup-row-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .popup-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .popup-status-active {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .status-indicator {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-accent);
    border-radius: 50%;
  }

  .popup-status-active span {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-accent-dark);
  }

  .popup-value {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .text-accent { color: var(--color-accent-dark); }
  .text-secondary { color: var(--color-text-secondary); }

  .popup-behaviour {
    padding: 0.75rem;
    background: var(--color-secondary);
    border-radius: 0.75rem;
  }

  .popup-behaviour .popup-row-left {
    margin-bottom: 0.5rem;
  }

  .popup-behaviour-text {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-left: 1.75rem;
  }

  .popup-settings {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.75rem;
    background: transparent;
    border: none;
    border-radius: 0.75rem;
    cursor: pointer;
    transition: background 0.2s;
  }

  .popup-settings:hover {
    background: var(--color-secondary);
  }

  .showcase-content {
    order: 1;
  }

  @media (min-width: 1024px) {
    .showcase-content { order: 2; }
  }

  .showcase-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    background: rgba(163, 230, 53, 0.1);
    border-radius: 9999px;
    margin-bottom: 1rem;
  }

  .showcase-badge span {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-accent-dark);
  }

  .showcase-title {
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .showcase-title { font-size: 2.25rem; }
  }

  .showcase-description {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }

  .showcase-checklist {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .checklist-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .check-icon {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: rgba(163, 230, 53, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.125rem;
    color: var(--color-accent-dark);
  }
</style>
