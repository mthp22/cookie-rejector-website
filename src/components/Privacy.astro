---
---

<section id="privacy" class="privacy">
  <div class="container privacy-inner">
    <div class="disclaimer" data-privacy-card>
      <div class="disclaimer-content">
        <h3 class="disclaimer-heading" data-privacy-heading> Important to know</h3>

        <p class="disclaimer-intro" data-privacy-intro>
          Your browsing experience matters, but it's important to understand
          what automatic cookie rejection can and cannot do.
        </p>

        <ul class="disclaimer-list">
          <li class="disclaimer-item">
            <span class="bullet">→</span>
            <span>Cookie consent interfaces vary between websites.</span>
          </li>

          <li class="disclaimer-item">
            <span class="bullet">→</span>
            <span>Automatic detection and rejection may not work on every site.</span>
          </li>

          <li class="disclaimer-item">
            <span class="bullet">→</span>
            <span>Cookie Rejector does not guarantee that all tracking is prevented.</span>
          </li>
        </ul>
        
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const card = document.querySelector("[data-privacy-card]");
  const heading = document.querySelector("[data-privacy-heading]");
  const intro = document.querySelector("[data-privacy-intro]");
  const items = document.querySelectorAll(".disclaimer-item");

  if (card && heading) {
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: card,
        start: "top 85%",
        once: true,
      },
    });

    tl.fromTo(card,
      {
        opacity: 0,
        y: 90,
        scale: 0.88,
        rotateX: -15,
        filter: "blur(12px)",
      },
      {
        opacity: 1,
        y: 0,
        scale: 1,
        rotateX: 0,
        filter: "blur(0px)",
        duration: 1.2,
        ease: "elastic.out(1, 0.7)",
      }
    );

    tl.fromTo(heading,
      {
        opacity: 0,
        y: 35,
        scale: 0.9,
        filter: "blur(8px)",
      },
      {
        opacity: 1,
        y: 0,
        scale: 1,
        filter: "blur(0px)",
        duration: 0.85,
        ease: "back.out(1.7)",
      },
      "-=0.3"
    );

    tl.fromTo(intro,
      { opacity: 0, y: 20 },
      {
        opacity: 1,
        y: 0,
        duration: 0.7,
        ease: "power3.out",
      },
      "-=0.4"
    );

    tl.fromTo(items,
      {
        opacity: 0,
        x: -30,
        y: 15,
      },
      {
        opacity: 1,
        x: 0,
        y: 0,
        duration: 0.65,
        stagger: 0.16,
        ease: "power3.out",
      },
      "-=0.2"
    );
  }
</script>

<style>
  .privacy {
    padding: 5rem 0;
    background: var(--color-primary);
  }

  @media (min-width: 768px) {
    .privacy {
      padding: 7rem 0;
    }
  }

  .privacy-inner {
    max-width: 52rem;
    display: flex;
    justify-content: center;
    margin-inline: auto;
  }

  .disclaimer {
    width: 100%;
    background: var(--color-secondary);
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    padding: 2rem;
    transform-origin: center center;
    will-change: transform, opacity;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .disclaimer:hover {
    border-color: rgba(182, 242, 59, 0.4);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.07);
  }

  .privacy-eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #6b9e24;
    margin-bottom: 0.9rem;
  }

  .disclaimer-heading {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .disclaimer-intro {
    max-width: 40rem;
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 1.75rem;
  }

  .disclaimer-list {
    list-style: none;
    display: grid;
    gap: 1rem;
    padding: 0;
    margin: 0;
  }

  .disclaimer-item {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text-primary);
  }

  .bullet {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 0.45rem;
    background: #163d2a;
    color: #b6f23b;
    font-size: 1rem;
    font-weight: 800;
    transition: transform 0.25s ease;
  }

  .disclaimer-item:hover .bullet {
    transform: translateX(4px);
  }

  .footer-line {
    width: 2rem;
    height: 2px;
    background: #a8df38;
    border-radius: 2px;
  }

  @media (max-width: 600px) {
    .disclaimer {
      padding: 1.5rem;
    }

    .disclaimer-heading {
      font-size: 1.85rem;
    }

    .disclaimer-item {
      font-size: 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .disclaimer,
    .privacy-eyebrow,
    .disclaimer-heading,
    .disclaimer-intro,
    .disclaimer-item{
      animation: none;
      transform: none;
      filter: none;
    }
  }
</style>