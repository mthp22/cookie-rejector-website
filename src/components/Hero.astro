---
---

<section class="hero">
  <div class="hero-bg"></div>
  <div class="container hero-inner">
    <div class="hero-content animate-fade-in-up">
      <div class="hero-badge">
        <div class="badge-dot"></div>
        <span>Privacy-focused browser extension</span>
      </div>

      <h1 class="hero-title">
        Your browsing.<br />
        <span class="hero-title-accent">Your choice.</span>
      </h1>

      <p class="hero-subtitle">Reject unwanted cookies without the endless clicking.</p>

      <p class="hero-description">
        Cookie Rejector automatically detects cookie consent banners and attempts to reject optional cookies, helping you browse with greater control over your privacy.
      </p>

      <div class="hero-ctas">
        <a href="#get-extension" class="btn-primary">Add to Edge</a>
        <a href="#how-it-works" class="btn-secondary">Discover how it works</a>
      </div>

      <div class="hero-points">
        <div class="hero-point">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Lightweight</span>
        </div>
        <div class="hero-point">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          <span>Privacy-focused</span>
        </div>
        <div class="hero-point">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
          <span>Easy to configure</span>
        </div>
      </div>
    </div>

    <div class="hero-mockup animate-fade-in-up" style="animation-delay: 200ms">
  <div class="privacy-card">
    <div class="privacy-card-top">
      <span class="privacy-label">PRIVACY PROTECTION</span>
      <span class="privacy-indicator"></span>
    </div>

    <div class="privacy-icon">🛡️</div>

    <h3>You're in control.</h3>
    <p>Unwanted cookies automatically rejected.</p>

    <div class="privacy-divider"></div>

    <div class="privacy-stat">
      <span>Essential cookies</span>
      <span class="stat-allowed">Allowed</span>
    </div>

    <div class="privacy-stat">
      <span>Analytics cookies</span>
      <span class="stat-blocked">Blocked</span>
    </div>

    <div class="privacy-stat">
      <span>Marketing cookies</span>
      <span class="stat-blocked">Blocked</span>
    </div>

    <div class="privacy-footer">
      <span class="privacy-check">✓</span>
      Automatic protection enabled
    </div>
  </div>
</div>
  </div>
</section>

<style>
.hero {
  position: relative;
  padding: 7.5rem 0 5rem;
  overflow: hidden;
  isolation: isolate;
}

.hero-bg {
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(
      ellipse at 78% 42%,
      rgba(163, 230, 53, 0.13),
      transparent 38%
    ),
    radial-gradient(
      ellipse at 10% 5%,
      rgba(163, 230, 53, 0.07),
      transparent 35%
    ),
    linear-gradient(
      to bottom,
      var(--color-secondary),
      var(--color-primary)
    );
}

.hero-inner {
  position: relative;
  display: grid;
  gap: 4rem;
  align-items: center;
}

@media (min-width: 1024px) {
  .hero-inner {
    grid-template-columns: 1.05fr 0.95fr;
    gap: 4rem;
  }
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  padding: 0.45rem 0.9rem;
  background: rgba(163, 230, 53, 0.12);
  border: 1px solid rgba(163, 230, 53, 0.2);
  border-radius: 9999px;
  margin-bottom: 1.75rem;
}

.badge-dot {
  width: 0.4rem;
  height: 0.4rem;
  background: var(--color-accent);
  border-radius: 50%;
  box-shadow: 0 0 10px rgba(163, 230, 53, 0.6);
}

.hero-badge span {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--color-accent-dark);
  letter-spacing: 0.015em;
}

.hero-title {
  font-size: 2.75rem;
  font-weight: 750;
  line-height: 1.04;
  letter-spacing: -0.055em;
  color: var(--color-text-primary);
  margin-bottom: 1.5rem;
}

@media (min-width: 640px) {
  .hero-title {
    font-size: 3.5rem;
  }
}

@media (min-width: 1024px) {
  .hero-title {
    font-size: clamp(3.5rem, 5vw, 4.5rem);
  }
}

.hero-title-accent {
  position: relative;
  display: inline-block;
  color: var(--color-text-primary);
  z-index: 1;
}

.hero-title-accent::after {
  content: '';
  position: absolute;
  bottom: 0.02em;
  left: 0;
  right: 0;
  height: 0.16em;
  background: var(--color-accent);
  border-radius: 9999px;
  opacity: 0.55;
  z-index: -1;
}

.hero-subtitle {
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: -0.025em;
  margin-bottom: 0.75rem;
}

@media (min-width: 640px) {
  .hero-subtitle {
    font-size: 1.3rem;
  }
}

.hero-description {
  font-size: 1rem;
  color: var(--color-text-secondary);
  margin-bottom: 2rem;
  max-width: 33rem;
  line-height: 1.8;
}

.hero-ctas {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  margin-bottom: 2.25rem;
}

@media (min-width: 640px) {
  .hero-ctas {
    flex-direction: row;
  }
}

.btn-primary,
.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.95rem 1.65rem;
  font-size: 0.9rem;
  font-weight: 600;
  border-radius: 9999px;
  text-decoration: none;
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease,
    border-color 0.25s ease;
}

.btn-primary {
  background: var(--color-text-primary);
  color: white;
  box-shadow: 0 5px 15px rgba(23, 26, 23, 0.1);
}

.btn-primary:hover {
  background: rgba(23, 26, 23, 0.88);
  transform: translateY(-3px);
  box-shadow: 0 10px 25px rgba(23, 26, 23, 0.16);
}

.btn-secondary {
  color: var(--color-text-primary);
  background: rgba(255, 255, 255, 0.65);
  border: 1px solid var(--color-border);
}

.btn-secondary:hover {
  background: white;
  border-color: rgba(23, 26, 23, 0.25);
  transform: translateY(-2px);
}

.hero-points {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem 1.5rem;
}

.hero-point {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--color-text-secondary);
  font-size: 0.825rem;
  font-weight: 500;
}

.hero-point svg {
  flex-shrink: 0;
  color: var(--color-accent-dark);
}

.hero-mockup {
  position: relative;
  max-width: 27rem;
  width: 100%;
  margin: 0 auto;
  z-index: 1;
}

@media (min-width: 1024px) {
  .hero-mockup {
    margin: 0 0 0 auto;
    padding-left: 1rem;
  }
}

.hero-mockup::before {
  content: '';
  position: absolute;
  inset: 5% -12%;
  background: rgba(163, 230, 53, 0.2);
  filter: blur(85px);
  border-radius: 50%;
  z-index: -1;
  opacity: 0.65;
  pointer-events: none;
}

.mockup-browser {
  background: white;
  border-radius: 1.15rem;
  box-shadow:
    0 30px 70px -20px rgba(0, 0, 0, 0.17),
    0 8px 25px rgba(0, 0, 0, 0.04);
  border: 1px solid rgba(0, 0, 0, 0.08);
  overflow: hidden;
  transition:
    transform 0.4s ease,
    box-shadow 0.4s ease;
}

.hero-mockup:hover .mockup-browser {
  transform: translateY(-5px);
  box-shadow:
    0 40px 85px -20px rgba(0, 0, 0, 0.2),
    0 10px 30px rgba(0, 0, 0, 0.05);
}

.mockup-chrome {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.85rem 1rem;
  background: #f7f8f5;
  border-bottom: 1px solid var(--color-border);
}

.mockup-dots {
  display: flex;
  gap: 0.375rem;
}

.dot {
  width: 0.7rem;
  height: 0.7rem;
  border-radius: 50%;
}

.dot.red { background: #fca5a5; }
.dot.yellow { background: #fde047; }
.dot.green { background: #86efac; }

.mockup-url {
  flex: 1;
  margin-left: 0.75rem;
  padding: 0.4rem 0.75rem;
  background: white;
  border: 1px solid var(--color-border);
  border-radius: 0.4rem;
  font-size: 0.7rem;
  color: var(--color-text-secondary);
}

.mockup-content {
  padding: 1.15rem;
  min-height: 14rem;
  background: #fff;
}

.mockup-lines {
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
  margin-bottom: 1.25rem;
}

.mockup-line {
  height: 0.65rem;
  background: #f0f1ed;
  border-radius: 0.3rem;
}

.w-75 { width: 75%; }
.w-50 { width: 50%; }
.w-85 { width: 85%; }

.cookie-banner {
  background: #fafbf8;
  border-radius: 0.85rem;
  padding: 1.1rem;
  border: 1px solid #e8eae3;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.045);
}

.banner-header {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-bottom: 1rem;
}

.banner-icon {
  width: 1.8rem;
  height: 1.8rem;
  border-radius: 0.55rem;
  background: rgba(163, 230, 53, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
}

.banner-title {
  font-size: 0.8rem;
  font-weight: 650;
  color: var(--color-text-primary);
}

.banner-options {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
  margin-bottom: 1rem;
}

.banner-option {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.75rem;
  color: var(--color-text-primary);
}

.checkbox {
  width: 1rem;
  height: 1rem;
  flex-shrink: 0;
  border: 1.5px solid #d5d9cf;
  border-radius: 0.3rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  border-color: var(--color-accent);
  background: rgba(163, 230, 53, 0.25);
  color: var(--color-accent-dark);
}

.rejected {
  color: #9ca398;
  text-decoration: line-through;
}

.option-tag {
  margin-left: auto;
  font-size: 0.625rem;
  color: #8b9485;
  font-weight: 500;
}

.rejected-tag {
  color: var(--color-accent-dark);
}

.banner-btn {
  width: 100%;
  padding: 0.65rem;
  background: var(--color-accent);
  border: none;
  border-radius: 0.55rem;
  font-size: 0.75rem;
  font-weight: 650;
  color: var(--color-accent-dark);
  cursor: default;
  transition: background 0.2s;
}

@media (max-width: 639px) {
  .hero {
    padding: 5.5rem 0 4rem;
  }

  .hero-inner {
    gap: 3.5rem;
  }

  .hero-title {
    font-size: 2.65rem;
  }

  .hero-description {
    font-size: 0.95rem;
  }

  .hero-points {
    gap: 0.85rem 1rem;
  }

  .hero-point {
    font-size: 0.78rem;
  }

  .hero-mockup {
    max-width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero *,
  .hero *::before,
  .hero *::after {
    animation: none !important;
    transition: none !important;
  }
}
</style>