
---
import { STORE_URL } from '../config';
---

<section class="hero">
  <div class="container hero-inner">
    <p class="hero-eyebrow">Microsoft Edge add-on</p>

    <h1 class="hero-title">
      Cookie Banners?<br />
      <span class="hero-title-accent">Rejected Automatically.</span>
    </h1>

    <p class="hero-description">
      Cookie Rejector detects cookie consent banners as you browse and picks the reject
      options for you, so optional cookies are not accepted by default.
    </p>

    <div class="hero-ctas">
      <a href={STORE_URL} class="btn-primary" rel="noopener">Add to Edge</a>
      <a href="#how-it-works" class="btn-secondary">How it works</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 7.5rem 1.5rem;
    background: var(--color-secondary);
    border-bottom: 1px solid var(--color-border);

    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .hero-inner {
    width: 100%;
    max-width: 48rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent-dark);
    background: rgba(163, 230, 53, 0.15);
    border: 1px solid rgba(163, 230, 53, 0.35);
    border-radius: 9999px;
    padding: 0.35rem 0.85rem;
    margin-bottom: 1.75rem;
  }

  .hero-title {
    font-size: 2.6rem;
    line-height: 1.06;
    letter-spacing: -0.04em;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 640px) {
    .hero-title {
      font-size: 3.4rem;
    }
  }

  .hero-title-accent {
    background-image: linear-gradient(
      to bottom,
      transparent 62%,
      rgba(163, 230, 53, 0.65) 62%
    );
  }

  .hero-description {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.75;
    max-width: 36rem;
    margin: 0 auto 2.25rem;
  }

  .hero-ctas {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 640px) {
    .hero-ctas {
      flex-direction: row;
    }
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: 9999px;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .btn-primary {
    background: var(--color-text-primary);
    color: white;
  }

  .btn-primary:hover {
    background: #2f352f;
  }

  .btn-secondary {
    color: var(--color-text-primary);
    background: white;
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    border-color: rgba(23, 26, 23, 0.3);
  }

  @media (max-width: 639px) {
    .hero {
      min-height: 80vh;
      padding: 5.5rem 1.25rem 4rem;
    }

    .hero-title {
      font-size: 2.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-inner > * {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  const hero = document.querySelector('.hero-inner');

  if (hero) {
    const elements = hero.children;
    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    if (reducedMotion) {
      gsap.set(elements, { opacity: 1, y: 0 });
    } else {
      gsap.fromTo(
        elements,
        {
          opacity: 0,
          y: 30,
        },
        {
          opacity: 1,
          y: 0,
          duration: 0.85,
          stagger: 0.16,
          ease: 'power3.out',
          delay: 0.15,
          clearProps: 'all',
        }
      );
    }
  }
</script>
