<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    transition: all 0.3s;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .navbar-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .brand-icon {
    width: 2rem;
    height: 2rem;
    background: var(--color-accent);
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s;
  }

  .navbar-brand:hover .brand-icon {
    transform: scale(1.05);
  }

  .brand-name {
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-text-primary);
  }

  .navbar-links {
    display: none;
    align-items: center;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .navbar-links { display: flex; }
    .navbar-toggle { display: none !important; }
  }

  .nav-link {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--color-text-primary);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    background: var(--color-text-primary);
    color: white;
    border-radius: 9999px;
    transition: all 0.2s;
  }

  .nav-cta:hover {
    background: rgba(23, 26, 23, 0.9);
    box-shadow: 0 4px 12px rgba(23, 26, 23, 0.15);
  }

  .navbar-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border: none;
    background: transparent;
    cursor: pointer;
    border-radius: 0.5rem;
    color: var(--color-text-primary);
  }

  .navbar-toggle:hover {
    background: var(--color-secondary);
  }

  .navbar-mobile {
    display: none;
    flex-direction: column;
    padding: 1rem;
    border-top: 1px solid var(--color-border);
    background: white;
    gap: 0.25rem;
  }

  .navbar-mobile.active {
    display: flex;
  }

  .nav-link-mobile {
    display: block;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    border-radius: 0.5rem;
    transition: all 0.2s;
  }

  .nav-link-mobile:hover {
    color: var(--color-text-primary);
    background: var(--color-secondary);
  }

  .nav-cta-mobile {
    display: block;
    margin: 0.5rem 1rem 0;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-align: center;
    background: var(--color-text-primary);
    color: white;
    border-radius: 9999px;
    transition: all 0.2s;
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('nav-mobile');
  const menuIcon = toggle?.querySelector('.icon-menu');
  const closeIcon = toggle?.querySelector('.icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = mobile?.classList.toggle('active');
    toggle.setAttribute('aria-expanded', String(isOpen));
    if (menuIcon && closeIcon) {
      menuIcon.style.display = isOpen ? 'none' : 'block';
      closeIcon.style.display = isOpen ? 'block' : 'none';
    }
  });

  mobile?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobile.classList.remove('active');
      toggle?.setAttribute('aria-expanded', 'false');
      if (menuIcon && closeIcon) {
        menuIcon.style.display = 'block';
        closeIcon.style.display = 'none';
      }
    });
  });
</script>
