---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import Privacy from '../components/Privacy.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Cookie Rejector — Take Control of Cookie Consent"
  description="Cookie Rejector helps you browse with greater privacy by automatically detecting cookie consent banners and attempting to reject optional cookies."
>
  <Navbar />
  <main>
    <Hero />
    <Features />
    <HowItWorks />
    <ProductShowcase />
    <Privacy />
    <FAQ />
    <CTA />
  </main>
  <Footer />
</Layout>
